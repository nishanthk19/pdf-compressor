{
  "name": "pdf-precision-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "build": "npm run build:css && prisma generate",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/css/tailwind.css --minify",
    "check": "node --check server.js && node --check src/pdf-tools.js && node --check src/ai-draft.js && node --check src/auth.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.1.18",
    "@prisma/client": "^6.3.1",
    "better-auth": "^1.1.18",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "overrides": {
    "qs": "6.16.0",
    "@prisma/config": { "deepmerge-ts": "8.0.2" }
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17"
  }
}
