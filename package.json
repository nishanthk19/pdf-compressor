{
  "name": "pdf-precision-platform",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "build": "npm run build:css && npm run build:studio && prisma generate",
    "build:studio": "esbuild frontend/letter-studio.js --bundle --minify --format=esm --outfile=public/js/letter-studio.bundle.js",
    "letter:readiness": "node scripts/letter-readiness.js",
    "letter:benchmark": "node scripts/letter-benchmark.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o public/css/tailwind.css --minify",
    "check": "node --check server.js && node --check src/pdf-tools.js && node --check src/ai-draft.js && node --check src/auth.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.1.18",
    "@prisma/client": "^6.3.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-font-family": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "^1.1.18",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "nodemailer": "10.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "1.64.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17"
  }
}
