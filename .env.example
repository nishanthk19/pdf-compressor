# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"
DEEPSEEK_API_KEY=""
CUSTOM_AI_MODEL="default"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Better Auth & Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/vibify?schema=public"
BETTER_AUTH_URL="https://vibify.tech"
BETTER_AUTH_SECRET=""
ADMIN_EMAILS="admin@example.com"
PORT=3000

# VPS-only PDF-to-Word engine (Docker sets these automatically).
PDF_WORD_PYTHON=/opt/word-venv/bin/python
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Mailtrap / SMTP Configuration
SMTP_HOST="live.smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Vibify" <noreply@vibify.tech>'

# Letter Studio is deliberately OFF until acceptance gates pass.
LETTER_STUDIO_ENABLED=false
LETTER_STORAGE_DIR=/data/letters
LETTER_AI_ENABLED=false
LETTER_AI_BENCHMARK_PASSED=false
LETTER_AI_PROVIDER=nvidia
# Set only in the runtime environment. Never commit a real key.
NVIDIA_API_KEY=
LETTER_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Operator approval of external processing, separate from model quality.
LETTER_NVIDIA_DATA_TRANSFER_ACCEPTED=false
# Embedding remains local by default. NVIDIA archive indexing is an explicit opt-in.
LETTER_EMBED_PROVIDER=ollama
LETTER_NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
LETTER_SEMANTIC_ENABLED=false
LETTER_OLLAMA_URL=http://ollama:11434
LETTER_AI_MODEL=qwen3:8b
LETTER_EMBED_MODEL=nomic-embed-text
# Provision separately with pre-downloaded model artifacts.
LETTER_EXTRACT_PYTHON=/opt/word-venv/bin/python
LETTER_RENDER_SOCKET=/run/letter-renderer/worker.sock
# Optional server-controlled Chromium executable path.
LETTER_CHROMIUM_PATH=
LETTER_CHROMIUM_NO_SANDBOX=false

